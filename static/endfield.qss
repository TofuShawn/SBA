/* ============================================================================
 * SBA — Endfield field-console theme (decision D23/D34)
 *
 * Palette aligned with the endfield-ui dark tokens:
 *   paper #191919 - panel #222222 - ink #EDEDED - ink2 #A3A3A3
 *   rule #353535 - chip #2E2E2E - signal #FFFA00 (fill only)
 *   command bar #161616 (dark in both themes) - radius 0 everywhere
 * The ChamferButton paints itself (chamfer + yellow wipe); the QSS here
 * covers everything else.
 * ========================================================================== */

QWidget {
    background: #191919;
    color: #EDEDED;
    font-family: "Saira", "Noto Sans TC", "Noto Sans SC", "Source Han Sans CN",
                 "Microsoft YaHei", "Segoe UI";
    font-size: 16px;
    selection-background-color: #FFFA00;
    selection-color: #161616;
}

QMainWindow { background: #191919; }
QStackedWidget { background: transparent; }
QWidget#pageMenu, QWidget#pageGame, QWidget#pageSettings { background: transparent; }

QFrame#card {
    background: #222222;
    border: 1px solid #353535;
    border-radius: 0;
}

QWidget#sidePanel {
    background: #1d1d1d;
    border-left: 1px solid #353535;
}

/* command bar + footer: dark in both themes (endfield constant) */
QFrame#commandBar {
    background: #161616;
    border-bottom: 1px solid #353535;
}
QFrame#footerTechnical {
    background: #161616;
    border-top: 1px solid #353535;
}

/* --- labels ------------------------------------------------------------- */

QLabel { background: transparent; color: #EDEDED; }
QLabel#title { font-size: 26px; font-weight: 800; color: #EDEDED; }
QLabel#cardTitle { font-size: 18px; font-weight: 700; color: #EDEDED; }
QLabel#muted { color: #A3A3A3; font-size: 14px; }
QLabel#deck { color: #A3A3A3; }
QLabel#deckAccent { color: #FFFA00; }
QLabel#deckNum { color: #3a3d41; font-weight: 800; }
QLabel#pctReadout { color: #EDEDED; font-weight: 700; }
QLabel#tag {
    background: #FFFA00; color: #161616;
    border: 1px solid #FFFA00; padding: 2px 10px;
    font-size: 14px; font-weight: 700;
}
QLabel#tagDark {
    background: #2E2E2E; color: #EDEDED;
    border: 1px solid #353535; padding: 2px 10px; font-size: 14px;
}

/* --- buttons ------------------------------------------------------------ */
/* ChamferButton paints itself; these cover any remaining plain buttons.   */

QPushButton {
    background: #2E2E2E; color: #EDEDED;
    border: 1px solid #353535; border-radius: 0;
    padding: 8px 18px; font-weight: 600;
}
QPushButton:hover { background: #3a3a3a; }
QPushButton:pressed { background: #454545; }
QPushButton:focus { border-color: #FFFA00; }
QPushButton:disabled { background: #1d1d1d; color: #6a6a6a; border-color: #2a2a2a; }

/* --- combo -------------------------------------------------------------- */

QComboBox {
    background: #2E2E2E; color: #EDEDED;
    border: 1px solid #353535; border-radius: 0;
    padding: 6px 10px; min-height: 24px; font-weight: 500;
}
QComboBox:hover { border-color: #6a6a6a; }
QComboBox:focus { border-color: #FFFA00; }
QComboBox:disabled { color: #6a6a6a; border-color: #2a2a2a; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox QAbstractItemView {
    background: #222222; color: #EDEDED;
    border: 1px solid #353535;
    selection-background-color: #FFFA00; selection-color: #161616;
    outline: none; padding: 4px;
}

/* --- sliders ------------------------------------------------------------ */

QSlider::groove:horizontal { height: 2px; background: #353535; border: none; }
QSlider::sub-page:horizontal { background: #FFFA00; }
QSlider::handle:horizontal {
    background: #EDEDED; width: 12px; height: 12px; margin: -6px 0;
    border: 1px solid #353535; border-radius: 0;
}
QSlider::handle:horizontal:hover { background: #FFFA00; }
QSlider::handle:horizontal:disabled { background: #6a6a6a; }

/* --- check / radio ------------------------------------------------------ */

QCheckBox, QRadioButton { background: transparent; color: #EDEDED; spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1px solid #6a6a6a; background: #1d1d1d; border-radius: 0;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #FFFA00; }
QCheckBox::indicator:focus, QRadioButton::indicator:focus { border-color: #FFFA00; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #FFFA00; border-color: #FFFA00;
}
QCheckBox:disabled, QRadioButton:disabled { color: #6a6a6a; }

/* --- list --------------------------------------------------------------- */
/* selected = "current": signal block with ink text (endfield state)        */

QListWidget {
    background: #1d1d1d; border: 1px solid #353535; padding: 2px;
    color: #EDEDED; border-radius: 0;
}
QListWidget::item { padding: 7px 8px; border-left: 2px solid transparent; }
QListWidget::item:hover { background: #2E2E2E; }
QListWidget::item:selected {
    background: #FFFA00; color: #161616; font-weight: 700;
    border-left: 2px solid #FFFA00;
}

/* --- tooltip / scrollbar ------------------------------------------------ */

QToolTip {
    background: #2E2E2E; color: #EDEDED;
    border: 1px solid #353535; padding: 6px 10px;
}
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #353535; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #6a6a6a; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #353535; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* --- Endfield-specific components --------------------------------------- */

QFrame#stripeM { background: #FF00F0; }
QFrame#stripeG { background: #00FFA2; }
QFrame#stripeY { background: #FFFA00; }

QProgressBar#loadingRail {
    background: #1d1d1d; border: 1px solid #2a2a2a;
    color: #A3A3A3; font-size: 12px;
}
QProgressBar#loadingRail::chunk { background: #FFFA00; }

QChartView { background: transparent; border: none; }

QMessageBox { background: #222222; }
QMessageBox QPushButton { min-width: 90px; }
