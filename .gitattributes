# Line-ending policy: LF everywhere in the repository, LF in working trees.
# Windows cmd scripts are the exception — cmd.exe misparses LF-only files.
* text=auto eol=lf
*.bat eol=crlf
*.png binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.dll binary
*.pt binary
*.bin binary

# The release zip (git archive in release.yml) ships the runtime, not the
# paper trail: the decision log, release notes, tutorials and the technical
# report live in the repository, not in a user's install folder.
docs/ export-ignore
